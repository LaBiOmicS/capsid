Bootstrap: docker
From: {{ registry_prefix }}/{{ recipe.name }}:{{ recipe.version }}

%labels
    Author {{ vendor }}
    Version {{ recipe.version }}
    Tool {{ recipe.name }}

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec {{ recipe.name }} "$@"

%test
    {{ recipe.test.command }}
