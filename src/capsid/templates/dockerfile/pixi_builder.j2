# ---- Builder: pixi conda environment ----
FROM {{ pixi_builder }} AS pixi_builder

# The environment is installed at {{ workspace }}/.pixi/envs/default, the path it has at runtime
WORKDIR {{ workspace }}
ARG SOURCE_DATE_EPOCH={{ source_date_epoch }}

{% if pixi_lock %}
# Locked environment (generated by `capsid lock`); manifest rendered by Capsid
COPY <<'EOF_PIXI_TOML' {{ workspace }}/pixi.toml
{{ pixi_manifest | trim | heredoc('EOF_PIXI_TOML') }}
EOF_PIXI_TOML

COPY <<'EOF_PIXI_LOCK' {{ workspace }}/pixi.lock
{{ pixi_lock | trim | heredoc('EOF_PIXI_LOCK') }}
EOF_PIXI_LOCK

RUN pixi install --locked
{% else %}
RUN pixi init{% for ch in channels %} --channel {{ ch | shq }}{% endfor %} {{ workspace }}
RUN pixi add {{ conda_packages | map('shq') | join(' ') }}
{% endif %}
