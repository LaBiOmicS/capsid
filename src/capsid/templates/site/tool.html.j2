{% extends "base.html.j2" %}
{% block title %}{{ tool.name }} — Capsid Hub{% endblock %}
{% block description %}{{ tool.description }}{% endblock %}
{% block content %}
<header class="page-head">
  <p class="crumbs"><a href="{{ root }}index.html">Capsid Hub</a> / <a href="{{ root }}catalogue/index.html">Catalogue</a> / {{ tool.name }}</p>
  <h1 class="mono-title">{{ tool.name }}</h1>
  <p class="lede">{{ tool.description }}</p>
</header>

<div class="split">
  <dl class="facts">
    <dt>Homepage</dt><dd>{% if tool.homepage %}<a href="{{ tool.homepage }}">{{ tool.homepage | replace("https://", "") | replace("http://", "") }}</a>{% else %}—{% endif %}</dd>
    <dt>Licence</dt><dd class="mono">{{ tool.license }}</dd>
    <dt>Latest</dt><dd><a href="{{ root }}{{ tool.latest.url }}" class="mono">{{ tool.latest.version }}</a></dd>
    <dt>Versions</dt><dd>{{ tool.versions | length }}</dd>
    {% if tool.categories %}<dt>Categories</dt><dd>{{ tool.categories | join(", ") }}</dd>{% endif %}
    {% if tool.doi %}<dt>DOI</dt><dd><a href="https://doi.org/{{ tool.doi }}" class="mono">{{ tool.doi }}</a></dd>{% endif %}
    {% if tool.edam_topics %}<dt>EDAM topics</dt><dd>{% for e in tool.edam_topics %}<a class="mono" href="http://edamontology.org/{{ e }}">{{ e }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
    {% if tool.edam_operations %}<dt>EDAM operations</dt><dd>{% for e in tool.edam_operations %}<a class="mono" href="http://edamontology.org/{{ e }}">{{ e }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
    <dt>Image</dt><dd class="mono small">{{ REGISTRY }}/{{ tool.name }}</dd>
  </dl>

  <div>
    <table class="booktabs">
      <caption><span class="figno">Table 1.</span> Published versions of {{ tool.name }}, newest first.</caption>
      <thead><tr><th>Version</th><th>Build</th><th>Architectures</th><th class="num">Closure</th><th class="num">Payload</th><th>Digest</th></tr></thead>
      <tbody>
      {% for v in tool.versions %}
        <tr>
          <td class="mono"><a href="{{ root }}{{ v.url }}">{{ v.version }}</a></td>
          <td class="mono">{{ v.build_type }}</td>
          <td class="mono">{{ v.platforms | join(", ") }}</td>
          <td class="num">{{ v.closure_count }}</td>
          <td class="num">{{ v.closure_bytes | bytes }}</td>
          <td class="mono small">{% if v.digest %}{{ v.digest | short }}…{% else %}<span class="muted">tag only</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% if tool.versions | length > 1 %}
    {% set a = tool.versions[0] %}{% set b = tool.versions[1] %}
    {% set an = a.closure_for(a.closure_platforms[0]) | map(attribute="name") | list %}
    {% set bn = b.closure_for(b.closure_platforms[0]) | map(attribute="name") | list %}
    {% set added = an | reject("in", bn) | list %}{% set removed = bn | reject("in", an) | list %}
    <p class="footnote">Between {{ b.version }} and {{ a.version }} the closure ({{ a.closure_platforms[0] }}) gained
      {{ added | length }} package{{ "" if added | length == 1 else "s" }}{% if added %} ({{ added | join(", ") }}){% endif %}
      and lost {{ removed | length }}{% if removed %} ({{ removed | join(", ") }}){% endif %}.</p>
    {% endif %}
  </div>
</div>
{% endblock %}
