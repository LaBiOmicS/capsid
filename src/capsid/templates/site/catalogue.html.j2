{% extends "base.html.j2" %}
{% import "_macros.html.j2" as m with context %}
{% block title %}Catalogue{% if page_no > 1 %}, page {{ page_no }}{% endif %} — Capsid Hub{% endblock %}
{% block content %}
{% macro href(n) %}{{ root }}{{ "catalogue/index.html" if n == 1 else "catalogue/page/" ~ n ~ "/index.html" }}{% endmacro %}
<p class="return"><a href="{{ root }}index.html">← Return to the overview</a></p>

<section class="opening">
  <div class="opening-text">
    <p class="kicker sc">Capsid Hub · Catalogue</p>
    <h1>{{ total }}&nbsp;tools, {{ inventory.tool_images }}&nbsp;versions, {{ stacks_n }}&nbsp;stacks.</h1>
    <p class="abstract"><span class="sc">Scope.</span>
      Every image published from this hub, one row per tool. A tool links to the history of its versions; a version
      links to its image page, where the tag and digest, the commands for each execution environment, the
      verification procedure and the complete locked closure are given. Search and filters act on the whole
      catalogue, not only on the page shown.</p>
    <p class="entry">
      <a href="#tools" class="lead-link">Go to the table</a>
      <span class="sep">or</span>
      <a href="{{ root }}stacks/index.html">see the stacks</a>
    </p>
  </div>
  <figure class="fig-composition" id="fig1">
    {% for group, rows in composition %}
    <table class="booktabs compact composition">
      <thead><tr><th colspan="3">{{ group }}</th></tr></thead>
      <tbody>
      {% for label, n in rows %}
        <tr><td class="mono small">{{ label }}</td><td class="num">{{ n }}</td>
          <td class="bar-cell"><span class="bar" style="--w: {{ (100 * n / total) | round(1) }}%"></span></td></tr>
      {% endfor %}
      </tbody>
    </table>
    {% endfor %}
    <figcaption><span class="figno">Fig. 1.</span> Composition of the catalogue, counted over tools (latest version of
      each). Bar length is the share of the {{ total }} tools.</figcaption>
  </figure>
</section>

<section class="numbered" id="find">
  <h2><span class="secno">1</span>Find a tool</h2>
  <div class="body">
    <form class="finder" data-finder role="search" onsubmit="return false">
      <label class="field grow"><span class="sc">Search</span>
        <input type="search" name="q" placeholder="name, description, category or version" autocomplete="off" spellcheck="false"></label>
      <label class="field"><span class="sc">Category</span>
        <select name="category"><option value="">any</option>{% for c in categories %}<option>{{ c }}</option>{% endfor %}</select></label>
      <label class="field"><span class="sc">Build</span>
        <select name="build"><option value="">any</option>{% for b in builds %}<option>{{ b }}</option>{% endfor %}</select></label>
      <label class="field"><span class="sc">Arch.</span>
        <select name="arch"><option value="">any</option><option value="arm64">includes arm64</option><option value="amd64only">amd64 only</option></select></label>
      <p class="status" aria-live="polite" data-status>Showing {{ (page_no - 1) * page_size + 1 }}–{{ (page_no - 1) * page_size + tools | length }} of {{ total }}; page {{ page_no }} of {{ pages_n }}.</p>
    </form>
  </div>
</section>

<section class="numbered" id="tools">
  <h2><span class="secno">2</span>Tools</h2>
  <div class="body">
    <table class="booktabs tools" data-catalogue data-page-size="{{ page_size }}" data-root="{{ root }}">
      <caption><span class="figno">Table 1.</span> Tools in alphabetical order, with the build of their latest version.
        <em>Closure</em> counts the locked artefacts in one architecture of that image.</caption>
      <thead><tr><th>Tool</th><th>Versions</th><th>Build</th><th>Arch.</th><th class="num">Closure</th><th>Licence</th></tr></thead>
      <tbody data-static>
{{ m.tool_rows(tools, root) }}
      </tbody>
    </table>
    <div data-static-pager>{{ m.pager(page_no, pages_n, href) }}</div>
    <script type="application/json" id="catalogue-index">{{ index_json | safe }}</script>
  </div>
</section>

<section class="numbered" id="reading">
  <h2><span class="secno">3</span>Reading the table</h2>
  <div class="body">
    <dl class="facts legend">
      <dt>Versions</dt><dd>every published version, newest first; each opens its image page.</dd>
      <dt>Build</dt><dd><code>pixi-conda</code> installs from conda-forge and Bioconda, <code>uv-pypi</code> from PyPI;
        source builds compile an archive pinned by checksum. See <a href="{{ root }}method/index.html#specification">Method §1</a>.</dd>
      <dt>Arch.</dt><dd>architectures under the single tag; the runtime selects the matching one.</dd>
      <dt>Closure</dt><dd>locked artefacts of one architecture, read from the lockfile. The Debian runtime underneath is
        pinned separately and is not counted.</dd>
      <dt>Licence</dt><dd>of the tool itself, as an SPDX identifier; dependency licences are listed on each image page.</dd>
    </dl>
    <p>A tool or version that is missing can be <a href="{{ root }}guide/contributing/index.html">submitted</a>.
      The same index is available as <a href="{{ root }}catalog.json"><code>catalog.json</code></a>.</p>
  </div>
</section>

<p class="return end"><a href="{{ root }}index.html">← Return to the overview</a></p>
{% endblock %}
