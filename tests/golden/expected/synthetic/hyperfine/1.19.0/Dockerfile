# syntax=docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc
# Multi-stage compilation container generated by Capsid

# ---- Builder: rust-cargo from a checksum-verified download ----
FROM rust:1.100.0-slim-bookworm@sha256:7c7d4eb4d05b7781187a327809466cfddf29753f6defdc3d19a0e291951b7a37 AS source_builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG SOURCE_DATE_EPOCH=1700000000

# Freeze apt to snapshot.debian.org/20261115T000000Z for reproducible system packages
RUN printf '%s\n' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian/20261115T000000Z' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian-security/20261115T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-capsid-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        build-essential \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log \
        /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old /var/lib/dpkg/*-old

WORKDIR /src
RUN curl -fsSL "https://github.com/sharkdp/hyperfine/archive/refs/tags/v1.19.0.tar.gz" -o archive \
    && echo "d1c782a54b9ebcdc1dedf8356a25ee11e11099a664a7d9413fdd3742138fa140  archive" | sha256sum -c - \
    && mkdir -p /src/unpack \
    && tar -xf archive -C /src/unpack --strip-components=1

WORKDIR /src/unpack

ENV CARGO_HOME=/tmp/cargo \
    CARGO_TERM_COLOR=never

# --locked: build exactly the dependency versions recorded in the project's Cargo.lock
RUN cargo install --locked --path . --root /opt/hyperfine
# Strip debug symbols to reduce image size
RUN if [ -d /opt/hyperfine/bin ]; then \
        find /opt/hyperfine/bin -type f -exec strip --strip-unneeded {} + 2>/dev/null || true; \
    fi

# ---- Runtime: hardened, non-root, tini as PID 1, HPC & workflow-engine ready ----
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime

ARG SOURCE_DATE_EPOCH=1700000000

# Freeze apt to snapshot.debian.org/20261115T000000Z for reproducible system packages
RUN printf '%s\n' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian/20261115T000000Z' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian-security/20261115T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-capsid-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        ca-certificates \
        bash \
    && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log \
        /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old /var/lib/dpkg/*-old

# Non-privileged user, universal HPC mount points, sticky scratch permissions
RUN groupadd -r -g 1000 bio && \
    useradd -r -u 1000 -g bio -m -d /home/bio -s /bin/bash bio && \
    mkdir -p /scratch /data /work /lustre /shared /tmp /home/bio && \
    chmod 1777 /tmp /scratch /data /work /lustre /shared

# PATH for login shells (profile.d) and PAM sessions (/etc/environment is not expanded);
# single quotes are intended: ${PATH:-} must be expanded at login, not at build time
# hadolint ignore=SC2016
RUN echo 'export PATH="/opt/hyperfine/bin:${PATH:-}"' > /etc/profile.d/capsid.sh && \
    chmod 0644 /etc/profile.d/capsid.sh && \
    echo 'PATH="/opt/hyperfine/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' >> /etc/environment

# Tool prefixes are owned by root: readable and executable by bio, not writable
COPY --from=source_builder /opt/hyperfine /opt/hyperfine
RUN chmod -R a+rX /opt/hyperfine && \
    mkdir -p /etc/capsid

