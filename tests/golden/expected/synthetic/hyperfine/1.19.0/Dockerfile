COPY <<'EOF_NF' /etc/capsid/module.nf
// Nextflow DSL2 Module for hyperfine v1.19.0
// Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

process HYPERFINE {
    tag "$meta.id"
    label 'process_medium'

    // Docker/Podman pull it directly; Apptainer/Singularity convert the same OCI image
    container "ghcr.io/labiomics/capsid/hyperfine:1.19.0"

    input:
    tuple val(meta), path(reads)

    output:
    tuple val(meta), path("*.out"), emit: results
    path "versions.yml"           , emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args = task.ext.args ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    # Execute hyperfine
    hyperfine \
        $args \
        $reads > "${prefix}.out"

    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        hyperfine: "1.19.0"
        container_engine: "${workflow.containerEngine}"
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch "${prefix}.out"
    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        hyperfine: "1.19.0"
    END_VERSIONS
    """
}
EOF_NF

COPY <<'EOF_SMK' /etc/capsid/rule.smk
# Snakemake Rule for hyperfine v1.19.0
# Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

rule hyperfine:
    input:
        reads = "data/samples/{sample}.fastq.gz"
    output:
        result = "results/hyperfine/{sample}.out"
    log:
        "logs/hyperfine/{sample}.log"
    threads: 4
    resources:
        mem_mb = 8000,
        time = "02:00:00"
    container:
        "docker://ghcr.io/labiomics/capsid/hyperfine:1.19.0"
    shell:
        """
        hyperfine \
            {input.reads} \
            -o {output.result} \
            > {log} 2>&1
        """
EOF_SMK

RUN chmod -R a+rX /etc/capsid

