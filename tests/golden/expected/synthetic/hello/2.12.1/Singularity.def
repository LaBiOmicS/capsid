Bootstrap: docker
From: ghcr.io/labiomics/capsid/hello:2.12.1

%labels
    Author LaBiOmicS, Universidade de Mogi das Cruzes (UMC)
    Version 2.12.1
    Tool hello

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec hello "$@"

%test
    hello --version | head -1
