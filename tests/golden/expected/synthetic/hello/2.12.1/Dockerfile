COPY <<'EOF_NF' /etc/capsid/module.nf
// Nextflow DSL2 Module for hello v2.12.1
// Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

process HELLO {
    tag "$meta.id"
    label 'process_medium'

    // Docker/Podman pull it directly; Apptainer/Singularity convert the same OCI image
    container "ghcr.io/labiomics/capsid/hello:2.12.1"

    input:
    tuple val(meta), path(reads)

    output:
    tuple val(meta), path("*.out"), emit: results
    path "versions.yml"           , emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args = task.ext.args ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    # Execute hello
    hello \
        $args \
        $reads > "${prefix}.out"

    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        hello: "2.12.1"
        container_engine: "${workflow.containerEngine}"
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch "${prefix}.out"
    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        hello: "2.12.1"
    END_VERSIONS
    """
}
EOF_NF

COPY <<'EOF_SMK' /etc/capsid/rule.smk
# Snakemake Rule for hello v2.12.1
# Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

rule hello:
    input:
        reads = "data/samples/{sample}.fastq.gz"
    output:
        result = "results/hello/{sample}.out"
    log:
        "logs/hello/{sample}.log"
    threads: 4
    resources:
        mem_mb = 8000,
        time = "02:00:00"
    container:
        "docker://ghcr.io/labiomics/capsid/hello:2.12.1"
    shell:
        """
        hello \
            {input.reads} \
            -o {output.result} \
            > {log} 2>&1
        """
EOF_SMK

RUN chmod -R a+rX /etc/capsid

ENV PATH="/opt/hello/bin:$PATH" \
    HOME="/home/bio" \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    XDG_CACHE_HOME="/tmp/.cache" \
    PYTHONPYCACHEPREFIX="/tmp/pycache" \
    NUMBA_CACHE_DIR="/tmp/numba" \
    MPLCONFIGDIR="/tmp/matplotlib"

LABEL org.opencontainers.image.title="hello" \
      org.opencontainers.image.version="2.12.1" \
      org.opencontainers.image.description="GNU Hello, autotools verification recipe" \
      org.opencontainers.image.url="" \
