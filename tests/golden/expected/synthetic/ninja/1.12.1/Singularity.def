Bootstrap: docker
From: ghcr.io/labiomics/capsid/ninja:1.12.1

%labels
    Author LaBiOmicS, Universidade de Mogi das Cruzes (UMC)
    Version 1.12.1
    Tool ninja

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec ninja "$@"

%test
    ninja --version
