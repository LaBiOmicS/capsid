# syntax=docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc
# Hardened container for a precompiled, checksum-verified binary generated by Capsid

# ---- Builder: binary from a checksum-verified download ----
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS source_builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG SOURCE_DATE_EPOCH=1700000000
ARG TARGETARCH

# Freeze apt to snapshot.debian.org/20261115T000000Z for reproducible system packages
RUN printf '%s\n' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian/20261115T000000Z' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian-security/20261115T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-capsid-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tar \
        gzip \
        bzip2 \
        xz-utils \
        unzip \
    && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log \
        /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old /var/lib/dpkg/*-old

WORKDIR /src
# One upstream artefact per architecture, each verified against its own checksum
RUN case "${TARGETARCH}" in \
        amd64) url="https://github.com/shenwei356/seqkit/releases/download/v2.8.2/seqkit_linux_amd64.tar.gz"; sum=a6515a64bf28ceba6922a3854d8ec898ca2ca637b4b00fc883c83076dfaf1ffa ;; \
        arm64) url="https://github.com/shenwei356/seqkit/releases/download/v2.8.2/seqkit_linux_arm64.tar.gz"; sum=8c12816c0bf6c01cfcda329fdb5f6c1479cf2485ce9413ce36b96237524da9dc ;; \
        *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "$url" -o artefact \
    && echo "$sum  artefact" | sha256sum -c - \
    && mkdir -p /src/unpack /opt/seqkit-bin/bin \
    && case "$url" in \
        *.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar) tar -xf artefact -C /src/unpack ;; \
        *.zip) unzip -q artefact -d /src/unpack ;; \
        *.gz) gunzip -c artefact > /src/unpack/seqkit-bin && chmod 0755 /src/unpack/seqkit-bin ;; \
        *) install -m 0755 artefact /src/unpack/seqkit-bin ;; \
    esac

WORKDIR /src/unpack
# Install every executable file shipped in the artefact into /opt/seqkit-bin/bin
RUN find . -maxdepth 4 -type f -perm -u+x -exec install -m 0755 -t /opt/seqkit-bin/bin {} + \
    && test -n "$(ls -A /opt/seqkit-bin/bin)"

# ---- Runtime: hardened, non-root, tini as PID 1, HPC & workflow-engine ready ----
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime

ARG SOURCE_DATE_EPOCH=1700000000

# Freeze apt to snapshot.debian.org/20261115T000000Z for reproducible system packages
RUN printf '%s\n' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian/20261115T000000Z' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian-security/20261115T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-capsid-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        ca-certificates \
        bash \
    && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log \
        /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old /var/lib/dpkg/*-old

# Non-privileged user, universal HPC mount points, sticky scratch permissions
RUN groupadd -r -g 1000 bio && \
    useradd -r -u 1000 -g bio -m -d /home/bio -s /bin/bash bio && \
    mkdir -p /scratch /data /work /lustre /shared /tmp /home/bio && \
    chmod 1777 /tmp /scratch /data /work /lustre /shared

# PATH for login shells (profile.d) and PAM sessions (/etc/environment is not expanded);
# single quotes are intended: ${PATH:-} must be expanded at login, not at build time
# hadolint ignore=SC2016
RUN echo 'export PATH="/opt/seqkit-bin/bin:${PATH:-}"' > /etc/profile.d/capsid.sh && \
    chmod 0644 /etc/profile.d/capsid.sh && \
    echo 'PATH="/opt/seqkit-bin/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' >> /etc/environment

# Tool prefixes are owned by root: readable and executable by bio, not writable
COPY --from=source_builder /opt/seqkit-bin /opt/seqkit-bin
RUN chmod -R a+rX /opt/seqkit-bin && \
    mkdir -p /etc/capsid

# -------------------------------------------------------------
# FAIR & provenance assets (/etc/capsid/)
# -------------------------------------------------------------

COPY <<'EOF_RECIPE' /etc/capsid/recipe.yaml
