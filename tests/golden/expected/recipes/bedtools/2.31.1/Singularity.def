Bootstrap: docker
From: ghcr.io/labiomics/capsid/bedtools:2.31.1

%labels
    Author LaBiOmicS, Universidade de Mogi das Cruzes (UMC)
    Version 2.31.1
    Tool bedtools

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec bedtools "$@"

%test
    bedtools
