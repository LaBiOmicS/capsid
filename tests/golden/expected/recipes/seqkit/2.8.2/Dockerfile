  sha256: ac71f913bada0a74686e081f7203eb442103149f88971faa35ef7ba26866e11c
  md5: 19b21fad10814dac04d104af61270a43
  license: MIT
  run_exports:
    weak:
    - seqkit >=2.8.2,<2.9.0a0
  size: 6959954
  timestamp: 1720653064935
EOF_PIXI_LOCK

RUN pixi install --locked

# ---- Runtime: hardened, non-root, tini as PID 1, HPC & workflow-engine ready ----
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS runtime

ARG SOURCE_DATE_EPOCH=1700000000

# Freeze apt to snapshot.debian.org/20261115T000000Z for reproducible system packages
RUN printf '%s\n' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian/20261115T000000Z' \
        'Suites: bookworm bookworm-updates' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        '' \
        'Types: deb' \
        'URIs: http://snapshot.debian.org/archive/debian-security/20261115T000000Z' \
        'Suites: bookworm-security' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        'Check-Valid-Until: no' \
        > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-capsid-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        tini \
        ca-certificates \
        bash \
    && rm -rf /var/lib/apt/lists/* /var/log/apt/* /var/log/dpkg.log \
        /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old /var/lib/dpkg/*-old

# Non-privileged user, universal HPC mount points, sticky scratch permissions
RUN groupadd -r -g 1000 bio && \
    useradd -r -u 1000 -g bio -m -d /home/bio -s /bin/bash bio && \
    mkdir -p /scratch /data /work /lustre /shared /tmp /home/bio && \
    chmod 1777 /tmp /scratch /data /work /lustre /shared

# PATH for login shells (profile.d) and PAM sessions (/etc/environment is not expanded)
RUN echo 'export PATH="/opt/conda-env/bin:${PATH:-}"' > /etc/profile.d/capsid.sh && \
    chmod 0644 /etc/profile.d/capsid.sh && \
    echo 'PATH="/opt/conda-env/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"' >> /etc/environment

# Tool prefixes are owned by root: readable and executable by bio, not writable
COPY --from=pixi_builder /build/.pixi/envs/default /opt/conda-env
RUN chmod -R a+rX /opt/conda-env

# -------------------------------------------------------------
# FAIR & provenance assets (/etc/capsid/)
# -------------------------------------------------------------
RUN mkdir -p /etc/capsid
COPY --from=pixi_builder /build/pixi.lock /etc/capsid/pixi.lock

COPY <<'EOF_RECIPE' /etc/capsid/recipe.yaml
