# syntax=docker/dockerfile:1.4@sha256:9ba7531bd80fb0a858632727cf7a112fbfd19b17e94c4e84ced81e24ef1a0dbc
# Multi-stage hardened Conda container generated by Capsid via Pixi (Rust)

# ---- Builder: Pixi (Rust / rattler) conda environment ----
FROM ghcr.io/prefix-dev/pixi:0.84.2@sha256:8201f134655a8261f382ee565ddf1498e5f215887bb14e812e1f47c09f4f7196 AS pixi_builder

WORKDIR /build
ARG SOURCE_DATE_EPOCH=1700000000

# Locked environment (generated by `capsid lock`); manifest rendered by Capsid
COPY <<'EOF_PIXI_TOML' /build/pixi.toml
[workspace]
name = "seqkit"
channels = ["conda-forge", "bioconda"]
platforms = ["linux-64", "linux-aarch64"]

[dependencies]
"seqkit" = "==2.8.2"
EOF_PIXI_TOML

COPY <<'EOF_PIXI_LOCK' /build/pixi.lock
version: 7
platforms:
- name: linux-64
  virtual-packages:
  - __unix=0
  - __linux=4.18
  - __glibc=2.28
  - __archspec=0=x86_64
- name: linux-aarch64
  virtual-packages:
  - __unix=0
  - __linux=4.18
  - __glibc=2.28
  - __archspec=0=aarch64
