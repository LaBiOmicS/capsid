COPY <<'EOF_NF' /etc/capsid/module.nf
// Nextflow DSL2 Module for minimap2 v2.28
// Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

process MINIMAP2 {
    tag "$meta.id"
    label 'process_medium'

    // Docker/Podman pull it directly; Apptainer/Singularity convert the same OCI image
    container "ghcr.io/labiomics/capsid/minimap2:2.28"

    input:
    tuple val(meta), path(reads)

    output:
    tuple val(meta), path("*.out"), emit: results
    path "versions.yml"           , emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args = task.ext.args ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    # Execute minimap2
    minimap2 \
        $args \
        $reads > "${prefix}.out"

    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        minimap2: "2.28"
        container_engine: "${workflow.containerEngine}"
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch "${prefix}.out"
    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        minimap2: "2.28"
    END_VERSIONS
    """
}
EOF_NF

COPY <<'EOF_SMK' /etc/capsid/rule.smk
# Snakemake Rule for minimap2 v2.28
# Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

rule minimap2:
    input:
        reads = "data/samples/{sample}.fastq.gz"
    output:
        result = "results/minimap2/{sample}.out"
    log:
        "logs/minimap2/{sample}.log"
    threads: 4
    resources:
        mem_mb = 8000,
        time = "02:00:00"
    container:
        "docker://ghcr.io/labiomics/capsid/minimap2:2.28"
    shell:
        """
        minimap2 \
            {input.reads} \
            -o {output.result} \
            > {log} 2>&1
        """
EOF_SMK

RUN chmod -R a+rX /etc/capsid

ENV PATH="/opt/conda-env/bin:$PATH" \
    HOME="/home/bio" \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    XDG_CACHE_HOME="/tmp/.cache" \
    PYTHONPYCACHEPREFIX="/tmp/pycache" \
    NUMBA_CACHE_DIR="/tmp/numba" \
    MPLCONFIGDIR="/tmp/matplotlib"

LABEL org.opencontainers.image.title="minimap2" \
      org.opencontainers.image.version="2.28" \
      org.opencontainers.image.description="A versatile pairwise aligner for genomic and spliced nucleotide sequences." \
      org.opencontainers.image.url="https://github.com/lh3/minimap2" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Capsid Project" \
      io.capsid.version="0.1.0" \
      io.capsid.engine="pixi-conda" \
      io.capsid.fair.ro_crate="/etc/capsid/ro-crate-metadata.json" \
      io.capsid.fair.sbom="/etc/capsid/sbom.spdx.json" \
      io.capsid.fair.module_nf="/etc/capsid/module.nf" \
      io.capsid.fair.rule_smk="/etc/capsid/rule.smk" \
      io.capsid.hpc="apptainer,singularity,slurm" \
      io.capsid.orchestrators="nextflow,snakemake"

# Numeric UID so Kubernetes runAsNonRoot can verify it
USER 1000:1000
WORKDIR /home/bio

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
