Bootstrap: docker
From: ghcr.io/labiomics/capsid/bwa:0.7.19

%labels
    Author LaBiOmicS, Universidade de Mogi das Cruzes (UMC)
    Version 0.7.19
    Tool bwa

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec bwa "$@"

%test
    bwa 2>&1 | grep "index sequences in the"
