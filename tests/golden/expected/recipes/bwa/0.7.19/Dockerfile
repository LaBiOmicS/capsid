COPY <<'EOF_NF' /etc/capsid/module.nf
// Nextflow DSL2 Module for bwa v0.7.19
// Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

process BWA {
    tag "$meta.id"
    label 'process_medium'

    // Docker/Podman pull it directly; Apptainer/Singularity convert the same OCI image
    container "ghcr.io/labiomics/capsid/bwa:0.7.19"

    input:
    tuple val(meta), path(reads)

    output:
    tuple val(meta), path("*.out"), emit: results
    path "versions.yml"           , emit: versions

    when:
    task.ext.when == null || task.ext.when

    script:
    def args = task.ext.args ?: ''
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    # Execute bwa
    bwa \
        $args \
        $reads > "${prefix}.out"

    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        bwa: "0.7.19"
        container_engine: "${workflow.containerEngine}"
    END_VERSIONS
    """

    stub:
    def prefix = task.ext.prefix ?: "${meta.id}"
    """
    touch "${prefix}.out"
    cat <<-END_VERSIONS > versions.yml
    "${task.process}":
        bwa: "0.7.19"
    END_VERSIONS
    """
}
EOF_NF

COPY <<'EOF_SMK' /etc/capsid/rule.smk
# Snakemake Rule for bwa v0.7.19
# Generated automatically by Capsid Engine (https://github.com/LaBiOmicS/capsid)

rule bwa:
    input:
        reads = "data/samples/{sample}.fastq.gz"
    output:
        result = "results/bwa/{sample}.out"
    log:
        "logs/bwa/{sample}.log"
    threads: 4
    resources:
        mem_mb = 8000,
        time = "02:00:00"
    container:
        "docker://ghcr.io/labiomics/capsid/bwa:0.7.19"
    shell:
        """
        bwa \
            {input.reads} \
            -o {output.result} \
            > {log} 2>&1
        """
EOF_SMK

