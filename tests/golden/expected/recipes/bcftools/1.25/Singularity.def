Bootstrap: docker
From: ghcr.io/labiomics/capsid/bcftools:1.25

%labels
    Author LaBiOmicS, Universidade de Mogi das Cruzes (UMC)
    Version 1.25
    Tool bcftools

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec bcftools "$@"

%test
    bcftools -h
