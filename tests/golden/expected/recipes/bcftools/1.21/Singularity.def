Bootstrap: docker
From: ghcr.io/labiomics/capsid/bcftools:1.21

%labels
    Author LaBiOmicS Capsid Project
    Version 1.21
    Tool bcftools

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec bcftools "$@"

%test
    bcftools -h
