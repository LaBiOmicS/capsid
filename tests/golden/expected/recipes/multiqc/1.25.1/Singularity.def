Bootstrap: docker
From: ghcr.io/labiomics/capsid/multiqc:1.25.1

%labels
    Author LaBiOmicS Capsid Project
    Version 1.25.1
    Tool multiqc

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec multiqc "$@"

%test
    python -c 'import multiqc; print("multiqc OK")'
