/*
 * Nextflow configuration for Capsid images (generated by `capsid export config`)
 *
 * Choose a container runtime, and optionally an executor:
 *   nextflow run main.nf -profile docker
 *   nextflow run main.nf -profile slurm,apptainer
 *
 * Requires Nextflow 24.04 or newer (process.resourceLimits).
 */

profiles {
    docker {
        docker.enabled         = true
        // Run as the calling user, so output files are not owned by root
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }

    podman {
        podman.enabled         = true
    }

    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        // Bind extra host paths if your data lives outside the work and input directories:
        // apptainer.runOptions = '-B /scratch -B /data'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // singularity.runOptions = '-B /scratch -B /data'
    }

    slurm {
        process.executor       = 'slurm'
        // process.queue          = 'normal'
        // process.clusterOptions = '--account=<your-account>'
    }
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Upper bounds for the retry-scaled requests below; adjust to your machine or cluster
    resourceLimits = [cpus: 16, memory: 64.GB, time: 24.h]

    withName: 'MULTIQC' {
        container     = 'ghcr.io/labiomics/capsid/multiqc:1.25.1'
        cpus          = { 4 * task.attempt }
        memory        = { 8.GB * task.attempt }
        time          = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}
