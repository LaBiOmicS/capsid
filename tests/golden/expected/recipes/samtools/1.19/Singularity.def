Bootstrap: docker
From: ghcr.io/labiomics/capsid/samtools:1.19

%labels
    Author LaBiOmicS Capsid Project
    Version 1.19
    Tool samtools

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec samtools "$@"

%test
    samtools --help
